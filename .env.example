# Development demo mode uses synthetic records only. Production disables demo login.
PORT=3001
DEMO_MODE=true
# For a fresh production database set these through secure runtime settings.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# DATA_DIR=/workspace/RestaurantOS/data
# APP_ORIGIN=https://your-domain.example

# Production authenticator encryption key: 64 hex characters, stored securely.
# APP_SECURITY_KEY=

# AI & automation (optional). Leave unset for deterministic-only assistants.
# AI_PROVIDER=none          # none | openai | groq | openrouter | ollama | mock
# AI_API_KEY=               # keep in the environment, never in the database
# AI_MODEL=                 # e.g. llama-3.3-70b-versatile (groq), deepseek/deepseek-chat (openrouter)
# AI_BASE_URL=              # default per provider; set for custom OpenAI-compatible hosts
#                           # ollama: http://localhost:11434/v1 (no key required)
